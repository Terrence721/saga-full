# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Gradle wrapper jar must be committed for ./gradlew to work for other
# clones/CI — this negation has to come after the *.jar rule above, since
# gitignore rules apply in file order and a later rule overrides an earlier one.
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.iws
.vscode/
*.code-workspace
.settings/
.project
.classpath
bin/
cspell.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env / secrets
.env
