{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compiler.nullAnalysis.mode": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "gradle.nestedProjects": true,
    "files.exclude": {
      "**/build": true,
      "**/.gradle": true
    },
    "search.exclude": {
      "**/build": true,
      "**/.gradle": true,
      "**/test-results": true
    }
  },
  "extensions": {
    "recommendations": [
      "redhat.java",
      "vscjava.vscode-java-pack",
      "vscjava.vscode-gradle",
      "vscjava.vscode-java-debug",
      "vscjava.vscode-java-dependency",
      "vscjava.vscode-java-test",
      "drblury.protobuf-vsc",
      "ms-azuretools.vscode-docker",
      "ms-azuretools.vscode-containers",
      "redhat.vscode-yaml",
      "github.vscode-github-actions",
      "github.vscode-pull-request-github",
      "davidanson.vscode-markdownlint",
      "humao.rest-client"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build all modules",
        "type": "shell",
        "command": "./gradlew build",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test all modules",
        "type": "shell",
        "command": "./gradlew test --continue",
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Aggregate test report",
        "type": "shell",
        "command": "./gradlew aggregateTestReport",
        "detail": "Merges every module's JUnit XML into build/reports/tests/aggregate/index.html — run after 'Test all modules'",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Clean stray .log files",
        "type": "shell",
        "command": "./gradlew cleanLogs",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: user-contract",
        "type": "shell",
        "command": "./gradlew :user-contract:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: user-service",
        "type": "shell",
        "command": "./gradlew :user-service:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: order-service",
        "type": "shell",
        "command": "./gradlew :order-service:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: payment-service",
        "type": "shell",
        "command": "./gradlew :payment-service:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: restaurant-service",
        "type": "shell",
        "command": "./gradlew :restaurant-service:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Test: api-gateway-service",
        "type": "shell",
        "command": "./gradlew :api-gateway-service:test",
        "group": "test",
        "problemMatcher": ["$gradle"]
      },
      {
        "label": "Docker: start infra (Postgres + Kafka)",
        "type": "shell",
        "command": "docker compose up -d",
        "problemMatcher": []
      },
      {
        "label": "Docker: stop infra",
        "type": "shell",
        "command": "docker compose down",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "Run user-service (H2, port 9090 gRPC)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.user.UserServiceApplication",
        "projectName": "user-service",
        "env": { "JWT_SECRET": "local-dev-secret-change-me" }
      },
      {
        "type": "java",
        "name": "Run order-service (H2, port 8081)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.order.OrderServiceApplication",
        "projectName": "order-service"
      },
      {
        "type": "java",
        "name": "Run payment-service (H2, port 8082)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.payment.PaymentServiceApplication",
        "projectName": "payment-service"
      },
      {
        "type": "java",
        "name": "Run restaurant-service (H2, port 8083)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.restaurant.RestaurantServiceApplication",
        "projectName": "restaurant-service"
      },
      {
        "type": "java",
        "name": "Run api-gateway-service (port 8080)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.gateway.ApiGatewayServiceApplication",
        "projectName": "api-gateway-service",
        "env": { "JWT_SECRET": "local-dev-secret-change-me" }
      },
      {
        "type": "java",
        "name": "Run order-service (real Postgres/Kafka, needs Docker infra up)",
        "request": "launch",
        "mainClass": "io.github.terrence721.saga.order.OrderServiceApplication",
        "projectName": "order-service",
        "env": { "SPRING_PROFILES_ACTIVE": "postgres", "DATABASE_PORT": "5433" }
      }
    ],
    "compounds": [
      {
        "name": "Run full saga chain (user + order + payment + restaurant + gateway)",
        "configurations": [
          "Run user-service (H2, port 9090 gRPC)",
          "Run order-service (H2, port 8081)",
          "Run payment-service (H2, port 8082)",
          "Run restaurant-service (H2, port 8083)",
          "Run api-gateway-service (port 8080)"
        ]
      }
    ]
  }
}
